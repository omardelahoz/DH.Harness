# DH Engineering Harness — Environment Configuration Template
# Copy this file to .env and configure as needed.

# Environment Mode: development | test | production
DH_ENV=development

# Workspace Root Directory (default: current working directory)
DH_WORKSPACE=.

# Antigravity SDK Configuration
ANTIGRAVITY_LOG_LEVEL=INFO
ANTIGRAVITY_API_TIMEOUT=30

# Git Governance Configuration
DH_GIT_MAIN_BRANCH=main
DH_GIT_ENFORCE_DOD=true
DH_GIT_ENFORCE_CONVENTIONAL_COMMITS=true

# Security & Secrets Engine
DH_SECURITY_STRICT_MODE=true
DH_SECURITY_SPDX_WHITELIST=MIT,Apache-2.0,BSD-2-Clause,BSD-3-Clause,ISC,PostgreSQL,MS-PL
